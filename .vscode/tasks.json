{
    "tasks": [
        {
            "type": "process",
            "label": "Arduino: Build active sketch (Uno)",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "set -euo pipefail\nsketch_file=\"$1\"\nsketch_name=\"$2\"\ntmpdir=$(mktemp -d)\ntrap 'rm -rf \"$tmpdir\"' EXIT\nmkdir -p \"$tmpdir/$sketch_name\"\ncp \"$sketch_file\" \"$tmpdir/$sketch_name/$sketch_name.ino\"\n\"$HOME/.local/bin/arduino-cli\" compile --fqbn arduino:avr:uno --build-path \"$tmpdir/build\" \"$tmpdir/$sketch_name\"",
                "arduino-build",
                "${file}",
                "${fileBasenameNoExtension}"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compiles only the active .ino for Arduino Uno using Arduino CLI."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang build active file",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}